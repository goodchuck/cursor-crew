{
  "manifest_version": 3,
  "name": "Cursor Crew",
  "version": "0.1.0",
  "description": "이름표를 단 커서들이 마우스를 따라다니다가, 멈추면 잡혀서 링크 열기·메모 같은 일을 해 줍니다.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cursor Crew 켜기/끄기 (Alt+Shift+C)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_page": "options.html",
  "commands": {
    "toggle-crew": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Cursor Crew 켜기/끄기"
    }
  }
}
