{
  "name": "cursor-crew",
  "version": "0.8.0",
  "private": true,
  "description": "작은 도트 펫이 마우스를 따라다니다가, Alt를 누른 채 클릭하면 링크 열기·메모 같은 기능을 실행하는 크롬 확장",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "harness": "vite --config vite.harness.config.ts",
    "store:shots": "node scripts/store-shots.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
